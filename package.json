{
  "name": "rrs-chatbot-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "test": "tsx --test tests/bot.test.ts tests/widget.test.ts tests/widget-runtime.test.ts",
    "test:api": "tsx --test tests/api.test.ts",
    "test:helpdesk": "tsx --test tests/helpdesk.test.ts",
    "test:migrations": "tsx --test tests/migrations.test.ts",
    "cf:build": "wrangler deploy --dry-run --outdir .wrangler/bundle",
    "cf:preview": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "test:deployment": "tsx --test tests/deployment.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@next/env": "16.4.3",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  }
}
