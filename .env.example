# Copy to .env.local for Next.js. Never commit real credentials.
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
# Demo database uses disk; never run multiple processes against this directory.
PGLITE_DIR=.data/rrs-demo
# Set DEMO_MODE=false and DATABASE_URL for real PostgreSQL. Use TLS in production.
DATABASE_URL=
SESSION_SECRET=
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional per-million-token USD rates; leave blank to show cost unavailable.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_DAILY_CALL_LIMIT=500
# Default public website organization identifier (provision before live use).
PUBLIC_ORG_SLUG=rrs
# Provision once with DEMO_MODE=false; remove these after provisioning.
ORGANIZATION_NAME=RRS
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_NAME=
PROVISION_ADMIN_PASSWORD=
# Set only behind a controlled proxy that strips/replaces incoming client headers.
TRUSTED_IP_HEADER=
