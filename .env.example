# Local Demo only; production uses Cloudflare bindings and Secrets.
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
D1_LOCAL_DIR=.data/rrs-demo-d1
AI_PROVIDER=demo
PUBLIC_ORG_SLUG=rrs
SESSION_SECRET=
# Production: AI_PROVIDER=disabled until a real provider is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_DAILY_CALL_LIMIT=100
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
FILE_STORAGE_LIMIT_BYTES=1073741824
# In Workers use cf-connecting-ip, supplied by Cloudflare.
TRUSTED_IP_HEADER=
